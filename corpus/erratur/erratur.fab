+++
term = "erratur"
kind = "keyword"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "proba_stmt", "proba_modifier", "adfirma_stmt", "incipit_stmt", "nota_stmt", "expression", "literal"]
category = "testing"
canonical = true
summary = "Marks a test as expected to fail."
syntax = "proba <name> erratur <block>"
aliases = ["expect failure"]
related = ["proba", "fragilis", "futurum"]
locale = "en"
+++
# =============================================================================
# erratur — Marks a test as expected to fail
# =============================================================================
#
# What this teaches:
#   • Expected failure — `erratur` (en `expect_failure`) takes no argument. The
#     case passes only when its body escapes through the error channel; a body
#     that completes cleanly fails the case (strict expected-failure).
#   • Modifier position — it sits between the test name and the body, like `omitte` and `fragilis`.
#
# Common mistakes:
#   • Marking a known-defect assertion with erratur — a failing `adfirma` is not
#     an error-channel escape, so `faber test` still reports the case as failed.
#     The case below fails under `faber test` for that reason.
#   • Confusing erratur (expected failure) with omitte (skipped) — an erratur test still runs.
#
# See also: proba, fragilis, omitte
# =============================================================================

# erratur — expected-failure test modifier
#
# GRAMMAR:
#   testModifier :← 'erratur'
#
# EXPECTED OUTPUT:
#   erratur declared

test "assertion still fails" expect_failure {
    assert 1 + 1 ≡ 3
}

main {
    print "erratur declared"
}
